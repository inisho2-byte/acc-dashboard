# ACC Dashboard Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================

# Admin API authentication token
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This protects /api/admin/* endpoints (circuit reset, circuit list)
ACC_ADMIN_TOKEN=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Data directory for persistent storage (SQLite database, indexes)
# Inside container: /data
# Host mount: ./data (created automatically by docker-compose)
ACC_DATA_DIR=/data

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Host binding (inside container)
HOST=0.0.0.0

# Port (inside container)
PORT=8643

# Number of Gunicorn workers (default: 2, increase for high load)
# Rule: (2 x CPU cores) + 1
WORKERS=2

# =============================================================================
# RATE LIMITING (optional overrides)
# =============================================================================

# Global rate limit: requests per minute
# DEFAULT_RATE_LIMIT=60

# Burst limit for monitoring endpoints
# MONITORING_RATE_LIMIT=120

# =============================================================================
# DISCORD API (if using Discord integration)
# =============================================================================

# Discord bot token (if applicable)
# DISCORD_BOT_TOKEN=

# Discord guild/server ID
# DISCORD_GUILD_ID=

# =============================================================================
# SSL/TLS (for future HTTPS deployment)
# =============================================================================

# Domain name (when deploying with SSL)
# DOMAIN=your-domain.com

# SSL certificate paths (mounted to nginx container)
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
